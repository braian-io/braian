# Kopiera till .env och byt alla värden. .env är gitignorerad.
# Värdena gäller bara den lokala utvecklingsmiljön.

POSTGRES_USER=braian
POSTGRES_PASSWORD=byt-mig
POSTGRES_DB=braian
POSTGRES_READONLY_PASSWORD=byt-mig-ocksa
# 5433 för att inte krocka med en lokalt installerad Postgres på 5432.
# Bara portnumret. Adressen styrs av POSTGRES_BIND (standard 127.0.0.1),
# så en lokal `just up` inte nås utifrån. Lägg aldrig 127.0.0.1: i
# POSTGRES_HOST_PORT när POSTGRES_BIND är satt: bindningsspecen blir ogiltig.
POSTGRES_HOST_PORT=5433
# POSTGRES_BIND=127.0.0.1

TYPESENSE_API_KEY=byt-mig-typesense
# 8108 som standard. Sätt en annan värdport för en isolerad stack.
# TYPESENSE_HOST_PORT=8108
# Bara portnumret. Adressen styrs av TYPESENSE_BIND (standard 127.0.0.1).
# Lägg aldrig 127.0.0.1: i TYPESENSE_HOST_PORT när TYPESENSE_BIND är satt.
# TYPESENSE_BIND=127.0.0.1

# Från värddatorn. I devcontainern skrivs dessa över med tjänstenamnen (postgres, typesense).
DATABASE_URL=postgres://braian:byt-mig@localhost:5433/braian
# Integrationstester skapar en egen databas. URL:en ska peka på underhållsdatabasen postgres.
BRAIAN_TEST_DATABASE_URL=postgres://braian:byt-mig@localhost:5433/postgres
# KAFKA_BROKERS is ignored if an old environment still sets it.
TYPESENSE_URL=http://localhost:8108
# Tomt: sökningen använder aliaset braian_objects. Tester sätter ett eget alias.
# BRAIAN_SEARCH_ALIAS=
# Antal syntetiska livsmedelsobjekt utöver hjälteobjekten (standard 1640: ca 40 leverantörer, 400 produkter, 1200 artiklar). 0 hoppar över.
# BRAIAN_SEED_COUNT=3000

# Postgres-MCP i Cursor: läsroll, bara utvecklingsdatabasen.
DATABASE_URI=postgresql://braian_readonly:byt-mig-ocksa@localhost:5433/braian

RUST_LOG=info,braian=debug

# API.
BRAIAN_API_ADDR=127.0.0.1:8090
# Två Postgres-pooler. Interaktiv trafik och bulk delar inte anslutningar.
# BRAIAN_POOL_INTERACTIVE=24
# BRAIAN_POOL_BULK=8
# Paus mellan bulk-slice:ar när ingen interaktiv trafik pågår, och taket när den pågår.
# Väntan växer med STEP per pågående anrop och stannar vid MAX, så importen inte fastnar.
# BRAIAN_BULK_YIELD_MS=1
# BRAIAN_BULK_YIELD_STEP_MS=4
# BRAIAN_BULK_YIELD_MAX_MS=25
# BRAIAN_BULK_JOBS=1
# BRAIAN_BULK_QUEUE=4
# BRAIAN_BULK_CHUNK=25
# Indexern. Interaktiva spåret är de tre första och skriver på en egen HTTP-klient.
# Det läser Postgres från en egen liten pool, skild från bulk.
# BRAIAN_INDEXER_POOL=2
# Bulk-spåret importerar korta vågor och väntar in det interaktiva spåret och
# interactive_pressure, högst YIELD_MAX millisekunder. Batch över 200 och
# samtidighet över 2 kapas. Under interaktiv last blir vågen ett anrop på högst 100.
# De första bulk-läsningarna är takade vid 200 händelser tills spåret är varmt.
# BRAIAN_INDEXER_BATCH=200
# BRAIAN_INDEXER_IMPORT_BATCH=100
# BRAIAN_INDEXER_IMPORT_CONCURRENCY=4
# BRAIAN_INDEXER_BULK_BATCH=2000
# BRAIAN_INDEXER_BULK_IMPORT_BATCH=100
# BRAIAN_INDEXER_BULK_IMPORT_CONCURRENCY=1
# BRAIAN_INDEXER_BULK_YIELD_MAX_MS=100
# Citat behövs: semikolon annars delas raden av skalet. En agent måste namnge personen: handle:agent@person:token
BRAIAN_DEV_TOKENS="ada:human:byt-mig;bot:agent@ada:byt-mig-agent"
# Demokontot skapas av `braian all` / `braian seed`. Byt lösenordet. Inget hemligt värde hör hemma i koden.
BRAIAN_DEMO_EMAIL=admin@braian.local
BRAIAN_DEMO_PASSWORD=braian-demo
BRAIAN_DEMO_TOKEN=braian-demo-token
# In-app feedback. Tom URL: funktionen är av (bara admins ser den när URL är satt).
# BRAIAN_FEEDBACK_WEBHOOK_URL=
# Hela header-raden, namn och värde. Värdet får innehålla kolon.
# BRAIAN_FEEDBACK_WEBHOOK_HEADER=Authorization: Bearer byt-mig
# Alternativt bara headerns namn, och värdet i BRAIAN_FEEDBACK_WEBHOOK_SECRET.
# BRAIAN_FEEDBACK_WEBHOOK_HEADER=X-Braian-Feedback
# BRAIAN_FEEDBACK_WEBHOOK_SECRET=byt-mig
# Filer (skärmdump och logg). Default är ./data/feedback.
# BRAIAN_FEEDBACK_DIR=./data/feedback

# In-app-agenten. Lämna nyckeln tom: gränssnittet säger då till på svenska i stället för att krascha.
BRAIAN_AGENT_MODEL=gpt-6-luna
OPENAI_API_KEY=
# Spreadsheet import spool. The Decisions client reads OPENAI_API_KEY above.
BRAIAN_IMPORT_DIR=./data/imports
BRAIAN_AGENT_MOCK=0
# 1 bara bakom HTTPS.
BRAIAN_COOKIE_SECURE=0
